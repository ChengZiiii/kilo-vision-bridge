{
  "name": "kilo-vision-bridge",
  "version": "0.1.2",
  "description": "Dynamic visual-response skill for Kilo. Registers the native vision_analyze tool (model configured by the user via the Kilo Code agent model override on vision-agent) with the vision-agent subagent as fallback, and teaches a text-only orchestrator to extract visual intent, design a task-specific JSON response template, and delegate via the tool (or subagent).",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun build ./plugin.ts --outfile ./dist/index.js --target node --format esm",
    "prepublishOnly": "bun run build",
    "postinstall": "node ./scripts/install-skill.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "kilo",
    "kilo-code",
    "kilo-cli",
    "kilo-plugin",
    "vision",
    "visual-judgment",
    "image-analysis",
    "screenshot",
    "subagent",
    "skill"
  ],
  "license": "MIT",
  "author": "chengsongren",
  "homepage": "https://github.com/chengsongren/kilo-vision-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengsongren/kilo-vision-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/chengsongren/kilo-vision-bridge/issues"
  },
  "peerDependencies": {
    "@kilocode/plugin": "^7.4.0"
  },
  "devDependencies": {
    "@kilocode/plugin": "^7.4.0",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  },
  "engines": {
    "opencode": "^7.0.0"
  }
}
