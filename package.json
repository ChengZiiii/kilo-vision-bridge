{
  "name": "kilo-vision-bridge",
  "version": "0.1.0",
  "description": "Dynamic visual-response skill for Kilo. Registers vision subagents from Kilo's configured image-capable models and teaches a text-only orchestrator to extract visual intent, design a task-specific JSON response template, and delegate to a vision subagent.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/images",
    "SKILL.md",
    "scripts",
    "subagent-body.md",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "bun build ./plugin.ts --outfile ./dist/index.js --target node --format esm --packages external",
    "models": "node ./scripts/vision-models.mjs",
    "prepublishOnly": "bun run build",
    "postinstall": "node ./scripts/install-skill.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "kilo",
    "kilo-code",
    "kilo-cli",
    "kilo-plugin",
    "vision",
    "visual-judgment",
    "image-analysis",
    "screenshot",
    "subagent",
    "skill"
  ],
  "license": "MIT",
  "author": "chengsongren",
  "homepage": "https://github.com/chengsongren/kilo-vision-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengsongren/kilo-vision-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/chengsongren/kilo-vision-bridge/issues"
  },
  "peerDependencies": {
    "@kilocode/plugin": "^7.4.0"
  },
  "devDependencies": {
    "@kilocode/plugin": "^7.4.0",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  },
  "engines": {
    "opencode": "^7.0.0"
  }
}
